#include <I2S.h>
#include <Core.hpp>

#include "Mic.hpp"

bool secondBuffer = false;
int16_t buf[Consts::Samples] = {};
int16_t bufSecond[Consts::Samples] = {};

bool (*ccallback)(int16_t *) = nullptr;

auto in = I2S(INPUT);

void Mic::setupMic(bool (*callback)(int16_t *)) {
    in.setDATA(D6);
    in.setBCLK(D7);
    in.setMCLK(D8);
    // LRCLK = BCLK + 1
    in.setBitsPerSample(32);
    in.setFrequency(44100);
    in.setStereo(false);
    in.begin();

    ccallback = callback;

    memset(buf, 0, Consts::Samples * sizeof(int16_t));
    memset(bufSecond, 0, Consts::Samples * sizeof(int16_t));
}

uint16_t counter = 0;


void Mic::runMicStep() {
    int32_t l, r;
    in.read32(&l, &r);
    const int16_t s = l >> 14;
    int16_t *activeBuf = secondBuffer ? bufSecond : buf;
    activeBuf[counter] = s;

    if (counter == Consts::Samples - 1) {
        // Serial.write(
        //     reinterpret_cast<uint8_t *>(activeBuf),
        //     Consts::Samples * sizeof(int16_t)
        // );

        const bool switchBuffer = ccallback(activeBuf);
        if (switchBuffer)
            secondBuffer = !secondBuffer;
        counter = 0;
    } else {
        counter++;
    }
}
