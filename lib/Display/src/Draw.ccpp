void drawDebugBars(const AnalyzeData *data, const int results[SAMPLES]) {
    // canvas.drawLine(SPRITEWIDTH - 6, SPRITEHEIGHT / 2 + (INCREASE_DIVIDER_PEAK / TRACE_SCALE), SPRITEWIDTH, SPRITEHEIGHT / 2 + (INCREASE_DIVIDER_PEAK / TRACE_SCALE), ILI9341_ORANGE);
    // canvas.drawLine(SPRITEWIDTH - 6, SPRITEHEIGHT / 2 + (DECREASE_DIVIDER_PEAK / TRACE_SCALE), SPRITEWIDTH, SPRITEHEIGHT / 2 + (DECREASE_DIVIDER_PEAK / TRACE_SCALE), ILI9341_GREEN);
    // canvas.drawLine(SPRITEWIDTH - 6, SPRITEHEIGHT / 2 + (OFF_THRESHOLD / TRACE_SCALE), SPRITEWIDTH, SPRITEHEIGHT / 2 + (OFF_THRESHOLD / TRACE_SCALE), ILI9341_RED);
    Display::spr.drawLine(SPRITEWIDTH - 12, SPRITEHEIGHT / 2 + (data->resultMax / TRACE_SCALE), SPRITEWIDTH - 6,
                          SPRITEHEIGHT / 2 + (data->resultMax / TRACE_SCALE), ILI9341_CYAN);

    Display::spr.fillRect(SPRITEWIDTH - 8, 0, 2, min(SPRITEHEIGHT, data->floatingAverage / FFT_SCALE), ILI9341_RED);
    Display::spr.fillRect(SPRITEWIDTH - 6, 0, 2, min(SPRITEHEIGHT, results[data->peakFrequencyIndex] / FFT_SCALE),
                          ILI9341_WHITE);
    Display::spr.fillRect(SPRITEWIDTH - 4, 0, 2, min(SPRITEHEIGHT, data->peakFrequencyValue / FFT_SCALE), ILI9341_PINK);
    Display::spr.fillRect(SPRITEWIDTH - 2, 0, 2, min(SPRITEHEIGHT, data->floatingAverageMin / FFT_SCALE),
                          ILI9341_ORANGE);
}
