#include <Arduino.h>
#include <Core.hpp>
#include <TFT_eSPI.h>

#include "Util.hpp"

#include "Display.hpp"


void drawSpriteIndizes(uint8_t peakFreaquencyIndexFloat, uint8_t peakFreaquencyIndex, uint8_t peakFreaquencyIndexLazy) {
    // Draw for peakFreaquencyIndexFloat (orange)
    Display::spr.fillRect(WIDTH_BAR * peakFreaquencyIndexFloat, 8, WIDTH_BAR - 1, 4, ILI9341_ORANGE);

    // Draw for peakFreaquencyIndex (white)
    Display::spr.fillRect(WIDTH_BAR * peakFreaquencyIndex, 2, WIDTH_BAR - 1, 4, ILI9341_WHITE);
    // sprite.fillRect(WIDTH_BAR * (peakFreaquencyIndex + 1), 2, WIDTH_BAR - 1, 4, ILI9341_WHITE);
    // sprite.fillRect(WIDTH_BAR * (peakFreaquencyIndex - 1), 2, WIDTH_BAR - 1, 4, ILI9341_WHITE);

    // Draw for peakFreaquencyIndexLazy (red)
    Display::spr.fillRect(WIDTH_BAR * peakFreaquencyIndexLazy, 12, WIDTH_BAR - 1, 4, ILI9341_RED);
}

void drawSpriteBars(const int approxBuffer[SAMPLES_USABLE], const int peakBuffer[SAMPLES_USABLE]) {
    for (uint16_t i = 0; i < SAMPLES_USABLE; i++) {
        if (i * WIDTH_BAR >= SPRITEWIDTH)
            break;
        uint16_t hr = approxBuffer[i] / FFT_SCALE;
        if (hr > SPRITEHEIGHT)
            hr = SPRITEHEIGHT;
        if (hr < 2)
            hr = 0;
        Display::spr.fillRect(WIDTH_BAR * i, SPRITEHEIGHT - hr, WIDTH_BAR - 1, hr, ILI9341_WHITE);

        uint16_t hp = peakBuffer[i] / FFT_SCALE;
        if (hp > SPRITEHEIGHT)
            hp = SPRITEHEIGHT;
        if (hp < 2)
            hp = 0;
        Display::spr.fillRect(WIDTH_BAR * i, SPRITEHEIGHT - hp, WIDTH_BAR - 1, hp - hr,
                              rainbowColor(127 + min(hp, (uint16_t) 96)));
    }
}

